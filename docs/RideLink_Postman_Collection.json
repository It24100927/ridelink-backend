{
	"info": {
		"_postman_id": "c1f2e3d4-5678-4a90-b123-ride-management",
		"name": "RideLink API Collection - Ride Management Service",
		"description": "Postman Collection for IT3130 RideLink Backend Microservices. Covers all endpoints, success workflows, lifecycle transitions, and negative test scenarios.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Successful Workflows",
			"item": [
				{
					"name": "1. Create Ride Request",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 201 Created', function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"var jsonData = pm.response.json();",
									"if (jsonData.rideId) {",
									"    pm.environment.set('ride_id', jsonData.rideId);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"passengerId\": \"{{passenger_id}}\",\n  \"pickupLocation\": \"Colombo 03\",\n  \"destination\": \"Kandy Central\"\n}"
						},
						"url": {
							"raw": "{{ride_service_url}}/api/rides",
							"host": [
								"{{ride_service_url}}"
							],
							"path": [
								"api",
								"rides"
							]
						}
					}
				},
