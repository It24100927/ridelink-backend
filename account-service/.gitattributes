# Auto detect text files and perform LF normalization
* text=auto

# Source code and configuration files
*.java text diff=java eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.properties text eol=lf
*.md text eol=lf
*.json text eol=lf
*.sql text eol=lf

# Build scripts
/mvnw text eol=lf
*.sh text eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files
*.jar binary
*.war binary
*.class binary
